<!DOCTYPE html>
<html lang="mr">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>GyanSetu - Daily Trading Challenge</title>

<style>

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,sans-serif;
}

body{
  background:#f4f7fb;
  color:#172033;
  max-width:430px;
  margin:auto;
  min-height:100vh;
}

/* HEADER */

.header{
  height:62px;
  background:white;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:0 15px;
  border-bottom:1px solid #e5e9f0;
  position:sticky;
  top:0;
  z-index:10;
}

.logo{
  color:#1769e0;
  font-size:21px;
  font-weight:800;
}

.back{
  width:38px;
  height:38px;
  border:0;
  border-radius:50%;
  background:#eef5ff;
  color:#1769e0;
  font-size:25px;
}

/* HERO */

.hero{
  margin:15px;
  padding:20px;
  border-radius:22px;
  color:white;
  background:linear-gradient(135deg,#1769e0,#4d9cff);
  box-shadow:0 8px 25px rgba(23,105,224,.18);
}

.hero small{
  opacity:.9;
}

.hero h1{
  margin-top:6px;
  font-size:25px;
}

.hero p{
  margin-top:8px;
  font-size:14px;
  line-height:1.5;
}

/* BALANCE */

.balance{
  margin:15px;
  padding:17px;
  background:white;
  border-radius:18px;
  box-shadow:0 4px 15px rgba(0,0,0,.06);
}

.balance-title{
  font-size:13px;
  color:#687386;
}

.balance-value{
  font-size:28px;
  font-weight:800;
  margin-top:5px;
}

.virtual{
  color:#1769e0;
  font-size:12px;
  margin-top:5px;
}

/* STOCK */

.stock{
  margin:15px;
  padding:18px;
  background:white;
  border-radius:20px;
  box-shadow:0 4px 15px rgba(0,0,0,.06);
}

.stock-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
}

.symbol{
  font-size:19px;
  font-weight:800;
}

.company{
  margin-top:4px;
  color:#7b8493;
  font-size:12px;
}

.price{
  text-align:right;
  font-size:22px;
  font-weight:800;
}

.change{
  text-align:right;
  color:#16a05d;
  font-size:13px;
  margin-top:3px;
}

/* CHART TOOLBAR */

.chart-toolbar{
  display:flex;
  gap:7px;
  margin-top:16px;
  overflow-x:auto;
}

.chart-btn{
  border:1px solid #dfe5ed;
  background:white;
  padding:7px 12px;
  border-radius:9px;
  font-size:12px;
  white-space:nowrap;
}

.chart-btn.active{
  background:#1769e0;
  color:white;
  border-color:#1769e0;
}

/* CHART */

.chart{
  height:245px;
  margin-top:10px;
  background:#fbfcfe;
  border:1px solid #edf0f5;
  border-radius:14px;
  overflow:hidden;
}

canvas{
  width:100%;
  height:100%;
  display:block;
}

/* LEGEND */

.legend{
  display:flex;
  gap:13px;
  flex-wrap:wrap;
  margin-top:10px;
  font-size:11px;
  color:#697487;
}

.dot{
  display:inline-block;
  width:8px;
  height:8px;
  border-radius:50%;
  margin-right:4px;
}

.price-dot{
  background:#1769e0;
}

.ma-dot{
  background:#8a5cf6;
}

.support-dot{
  background:#16a05d;
}

.resistance-dot{
  background:#e04b4b;
}

/* QUESTION */

.question{
  margin:15px;
  padding:20px;
  background:white;
  border-radius:20px;
  box-shadow:0 4px 15px rgba(0,0,0,.06);
}

.question-label{
  color:#1769e0;
  font-size:13px;
  font-weight:800;
}

.question h2{
  margin-top:8px;
  font-size:19px;
  line-height:1.45;
}

.options{
  display:grid;
  gap:10px;
  margin-top:15px;
}

.option{
  width:100%;
  border:1px solid #dfe5ed;
  background:white;
  padding:14px;
  border-radius:13px;
  text-align:left;
  font-size:15px;
  font-weight:600;
  cursor:pointer;
}

.option:disabled{
  cursor:default;
}

.option.correct{
  background:#e8f8ef;
  border-color:#22a866;
  color:#137447;
}

.option.wrong{
  background:#fff0f0;
  border-color:#e04b4b;
  color:#b32929;
}

/* RESULT */

.result{
  display:none;
  margin:15px;
  padding:20px;
  text-align:center;
  background:white;
  border-radius:20px;
  box-shadow:0 4px 15px rgba(0,0,0,.06);
}

.result-icon{
  font-size:45px;
}

.result h2{
  margin-top:8px;
}

.result p{
  margin-top:8px;
  color:#687386;
  line-height:1.5;
}

.xp{
  margin-top:15px;
  padding:13px;
  background:#eef5ff;
  color:#1769e0;
  border-radius:13px;
  font-weight:800;
}

.next{
  width:100%;
  margin-top:15px;
  border:0;
  padding:14px;
  border-radius:13px;
  background:#1769e0;
  color:white;
  font-size:16px;
  font-weight:800;
}

/* INFO */

.info{
  margin:15px;
  padding:15px;
  border-radius:16px;
  background:#fffbea;
  border:1px solid #f3e4a8;
  color:#665a24;
  font-size:12px;
  line-height:1.5;
}

.footer{
  text-align:center;
  color:#8a93a2;
  font-size:11px;
  padding:20px;
}

</style>

</head>


<body>


