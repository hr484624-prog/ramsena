<script>


/* =================================
   BACK
================================= */

function goBack(){

  window.location.href =
    "home.html";

}



/* =================================
   CHART
================================= */

const canvas =
  document.getElementById("chart");

const ctx =
  canvas.getContext("2d");


let values = [];

let targetValues = [];

let currentPrice = 245;

let targetPrice = 245;


/* =================================
   INITIAL DATA
================================= */

for(
  let i = 0;
  i < 70;
  i++
){

  currentPrice +=
    (Math.random() - 0.47) * 1.5;

  values.push(
    currentPrice
  );

}


targetValues =
  [...values];



/* =================================
   CANVAS SIZE
================================= */

function resizeCanvas(){

  const dpr =
    window.devicePixelRatio || 1;


  canvas.width =
    canvas.clientWidth * dpr;

  canvas.height =
    canvas.clientHeight * dpr;


  ctx.setTransform(
    dpr,
    0,
    0,
    dpr,
    0,
    0
  );


  drawChart();

}


window.addEventListener(
  "resize",
  resizeCanvas
);



/* =================================
   NEW MARKET TARGET
================================= */

function createNextTarget(){

  const last =
    targetValues[
      targetValues.length - 1
    ];


  const movement =
    (Math.random() - 0.48) * 2.2;


  const next =
    last + movement;


  targetValues.push(
    next
  );


  if(
    targetValues.length > 70
  ){

    targetValues.shift();

  }


  targetPrice =
    next;

}



/* =================================
   SMOOTH ANIMATION
================================= */

function animate(){

  for(
    let i = 0;
    i < values.length;
    i++
  ){

    const current =
      values[i];

    const target =
      targetValues[i];


    values[i] =
      current +
      (
        target -
        current
      ) * 0.025;

  }


  currentPrice +=
    (
      targetPrice -
      currentPrice
    ) * 0.025;


  document.getElementById(
    "price"
  ).innerText =
    "₹" +
    currentPrice.toFixed(2);


  drawChart();


  requestAnimationFrame(
    animate
  );

}



/* =================================
   MARKET MOVEMENT
================================= */

setInterval(
  createNextTarget,
  1600
);



/* =================================
   UPDATE PERCENT
================================= */

setInterval(

  function(){

    const percent =
      (
        (currentPrice - 240) /
        240
      ) * 100;


    const change =
      document.getElementById(
        "change"
      );


    change.innerText =
      (
        percent >= 0
          ? "+"
          : ""
      ) +
      percent.toFixed(2) +
      "%";


    if(percent >= 0){

      change.style.color =
        "#16a05d";

    }else{

      change.style.color =
        "#e04b4b";

    }

  },

  300

);



/* =================================
   DRAW CHART
================================= */

function drawChart(){

  const w =
    canvas.clientWidth;

  const h =
    canvas.clientHeight;


  ctx.clearRect(
    0,
    0,
    w,
    h
  );


  if(values.length < 2){

    return;

  }


  let max =
    Math.max(
      ...values
    );


  let min =
    Math.min(
      ...values
    );


  let range =
    max - min;


  if(range < 8){

    const middle =
      (max + min) / 2;


    max =
      middle + 5;

    min =
      middle - 5;

    range =
      max - min;

  }


  const padding =
    28;



  /* =================================
     GRID
  ================================= */

  ctx.strokeStyle =
    "#e9edf3";

  ctx.lineWidth = 1;


  for(
    let i = 1;
    i < 5;
    i++
  ){

    const y =
      (h / 5) * i;


    ctx.beginPath();


    ctx.moveTo(
      0,
      y
    );


    ctx.lineTo(
      w,
      y
    );


    ctx.stroke();

  }



  /* =================================
     PRICE LINE
  ================================= */

  ctx.beginPath();


  values.forEach(

    function(v,i){

      const x =
        padding +
        i *
        (
          (w - padding * 2) /
          (values.length - 1)
        );


      const y =
        h -
        padding -
        (
          (v - min) /
          range
        ) *
        (
          h -
          padding * 2
        );


      if(i === 0){

        ctx.moveTo(
          x,
          y
        );

      }else{

        ctx.lineTo(
          x,
          y
        );

      }

    }

  );


  ctx.strokeStyle =
    "#1769e0";

  ctx.lineWidth =
    2.7;

  ctx.lineJoin =
    "round";

  ctx.lineCap =
    "round";

  ctx.stroke();



  /* =================================
     PRICE AREA
  ================================= */

  ctx.lineTo(
    w - padding,
    h - padding
  );


  ctx.lineTo(
    padding,
    h - padding
  );


  ctx.closePath();


  ctx.globalAlpha =
    0.06;


  ctx.fillStyle =
    "#1769e0";


  ctx.fill();


  ctx.globalAlpha =
    1;



  /* =================================
     MOVING AVERAGE
  ================================= */

  const ma = [];


  for(
    let i = 0;
    i < values.length;
    i++
  ){

    const start =
      Math.max(
        0,
        i - 8
      );


    const part =
      values.slice(
        start,
        i + 1
      );


    const average =
      part.reduce(
        function(a,b){
          return a+b;
        },
        0
      ) /
      part.length;


    ma.push(
      average
    );

  }


  ctx.beginPath();


  ma.forEach(

    function(v,i){

      const x =
        padding +
        i *
        (
          (w - padding * 2) /
          (ma.length - 1)
        );


      const y =
        h -
        padding -
        (
          (v - min) /
          range
        ) *
        (
          h -
          padding * 2
        );


      if(i === 0){

        ctx.moveTo(
          x,
          y
        );

      }else{

        ctx.lineTo(
          x,
          y
        );

      }

    }

  );


  ctx.strokeStyle =
    "#8a5cf6";

  ctx.lineWidth =
    1.6;

  ctx.lineJoin =
    "round";

  ctx.lineCap =
    "round";

  ctx.stroke();



  /* =================================
     SUPPORT
  ================================= */

  const support =
    min +
    range * 0.20;


  drawHorizontalLine(
    support,
    min,
    max,
    "#16a05d",
    "Support"
  );



  /* =================================
     RESISTANCE
  ================================= */

  const resistance =
    min +
    range * 0.80;


  drawHorizontalLine(
    resistance,
    min,
    max,
    "#e04b4b",
    "Resistance"
  );

}



/* =================================
   HORIZONTAL LINE
================================= */

function drawHorizontalLine(
  level,
  min,
  max,
  color,
  label
){

  const w =
    canvas.clientWidth;

  const h =
    canvas.clientHeight;


  const padding =
    28;


  const range =
    max - min;


  const y =
    h -
    padding -
    (
      (level - min) /
      range
    ) *
    (
      h -
      padding * 2
    );


  ctx.beginPath();


  ctx.setLineDash([
    6,
    5
  ]);


  ctx.moveTo(
    padding,
    y
  );


  ctx.lineTo(
    w - padding,
    y
  );


  ctx.strokeStyle =
    color;

  ctx.lineWidth = 1;


  ctx.stroke();


  ctx.setLineDash([]);


  ctx.font =
    "10px Arial";


  ctx.fillStyle =
    color;


  ctx.fillText(
    label,
    6,
    y - 4
  );

}



/* =================================
   PERIOD
================================= */

function setPeriod(
  period,
  button
){

  document
    .querySelectorAll(
      ".chart-btn"
    )
    .forEach(
      function(b){

        b.classList.remove(
          "active"
        );

      }
    );


  button.classList.add(
    "active"
  );


  let speed = 1;


  if(period === "1W"){

    speed = 1.25;

  }


  if(period === "1M"){

    speed = 1.7;

  }


  if(period === "1Y"){

    speed = 2.3;

  }


  targetValues = [];


  let value =
    245;


  for(
    let i = 0;
    i < 70;
    i++
  ){

    value +=
      (
        Math.random() -
        0.47
      ) *
      speed *
      1.5;


    targetValues.push(
      value
    );

  }


  values =
    [...targetValues];


  currentPrice =
    targetValues[
      targetValues.length - 1
    ];


  targetPrice =
    currentPrice;


  drawChart();

}



/* =================================
   QUESTIONS
================================= */

const questions = [

  {

    q:
      "Price moving average च्या वर आहे आणि trend upward आहे. तू काय करशील?",

    options:[
      "📈 BUY / Long चा अभ्यास करेन",
      "📉 SELL करेन",
      "⏳ Confirmation साठी WAIT करेन",
      "🎲 Random trade करेन"
    ],

    correct:"buy"

  },


  {

    q:
      "Price Support जवळ आहे. Beginner म्हणून disciplined approach कोणता?",

    options:[
      "📈 लगेच BUY",
      "📉 लगेच SELL",
      "👀 Confirmation पाहणे",
      "🎲 Random trade"
    ],

    correct:"wait"

  },


  {

    q:
      "Market खूप वेगाने वर-खाली होत आहे. काय करणे योग्य?",

    options:[
      "🔥 अनेक trades घेणे",
      "💰 सगळे virtual balance वापरणे",
      "⏳ परिस्थिती समजून confirmation ची वाट पाहणे",
      "🎲 Random BUY"
    ],

    correct:"wait"

  },


  {

    q:
      "Stop-loss चा मुख्य उद्देश काय आहे?",

    options:[
      "Profit guarantee करणे",
      "Potential loss नियंत्रित ठेवणे",
      "Price वाढवणे",
      "Chart बदलणे"
    ],

    correct:"buy"

  }

];


let currentQuestion =
  0;

let answered =
  false;



/* =================================
   ANSWER
================================= */

function answer(
  button,
  type
){

  if(answered){

    return;

  }


  answered =
    true;


  const q =
    questions[
      currentQuestion
    ];


  document
    .querySelectorAll(
      ".option"
    )
    .forEach(
      function(b){

        b.disabled =
          true;

      }
    );


  if(type === q.correct){

    button.classList.add(
      "correct"
    );


    showResult(
      "🎉",
      "Great!",
      "तुझा answer educational context मध्ये योग्य दिशेने आहे. पण कोणत्याही chart वर decision घेण्याआधी confirmation आणि risk समजून घेणे महत्त्वाचे आहे.",
      50
    );


  }else{

    button.classList.add(
      "wrong"
    );


    showResult(
      "📚",
      "Keep Learning!",
      "Trading मध्ये फक्त एका signal वर decision घेण्याऐवजी chart, confirmation आणि risk management समजून घेणे महत्त्वाचे आहे.",
      20
    );

  }

}



/* =================================
   RESULT
================================= */

function showResult(
  icon,
  title,
  text,
  xp
){

  document.getElementById(
    "resultIcon"
  ).innerText =
    icon;


  document.getElementById(
    "resultTitle"
  ).innerText =
    title;


  document.getElementById(
    "resultText"
  ).innerText =
    text;


  document.getElementById(
    "xpText"
  ).innerText =
    "+" +
    xp +
    " XP";


  document.getElementById(
    "result"
  ).style.display =
    "block";


  let oldXP =
    Number(
      localStorage.getItem(
        "gyansetu_xp"
      ) || 0
    );


  localStorage.setItem(
    "gyansetu_xp",
    oldXP + xp
  );


  document.getElementById(
    "result"
  ).scrollIntoView({
    behavior:"smooth"
  });

}



/* =================================
   NEW CHALLENGE
================================= */

function newChallenge(){

  answered =
    false;


  currentQuestion =
    Math.floor(
      Math.random() *
      questions.length
    );


  const q =
    questions[
      currentQuestion
    ];


  document.getElementById(
    "question"
  ).innerText =
    q.q;


  document
    .querySelectorAll(
      ".option"
    )
    .forEach(
      function(button,index){

        button.disabled =
          false;


        button.classList.remove(
          "correct",
          "wrong"
        );


        button.innerText =
          q.options[index];

      }
    );


  document.getElementById(
    "result"
  ).style.display =
    "none";

}



/* =================================
   START
================================= */

resizeCanvas();

animate();


</script>

